# Copy to .env and fill in. .env is git-ignored; never commit it.

# Public URL served by your reverse proxy. Google sends users back to
# $MIMIR_BASE_URL/auth/callback after sign-in.
MIMIR_BASE_URL=https://example.dev

# Google OAuth client: Google Cloud Console > APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application.
# Authorized redirect URI: https://example.dev/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google accounts allowed to sign in, comma-separated. Everyone else is refused.
MIMIR_ALLOWED_EMAILS=you@gmail.com

# Where the reverse proxy reaches the app. Keep 127.0.0.1 when the proxy runs
# on the same host.
MIMIR_BIND=127.0.0.1
MIMIR_PORT=8080

# Optional. Address the reverse proxy connects from (the remote= field in the
# logs, usually the Docker gateway). Its X-Real-IP header is then logged as
# client=. Comma-separated IPs or CIDRs.
MIMIR_TRUSTED_PROXIES=

# Folder with your .pdf / .epub files on the host.
MIMIR_BOOKS_DIR=./ebook
